# Storage backend: "json" (flat backend/db.json, default — no Postgres setup
# needed, good for local dev/demo) or "postgres" (SQLAlchemy models, requires
# DATABASE_URL below).
STORAGE_BACKEND=json

# Only required when STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/face_attendance

# Required for every storage backend — the server refuses to start without
# it (no insecure default is baked into the code, on purpose).
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of origins allowed to call this API. Defaults to the
# Vite dev server (localhost:5173) if unset. Set this to your real frontend
# origin(s) before deploying anywhere beyond local dev.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First-admin bootstrap: set these once, start the server, then leave them
# set or unset — the account is only created if no admin exists yet.
# Not needed if you're using the seeded sample backend/db.json, which
# already has an admin account (admin@example.com / admin123).
FIRST_ADMIN_NAME=Admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-this-password
